# LocalBoost — Gemini configuration
# Copy this file to server/.env and fill in YOUR OWN Google Gemini API key.
# The server reads these at startup. Without a key the product runs in
# SIMULATION MODE (fully functional demo) and switches to LIVE Gemini automatically.

USER_GEMINI_API_KEY=your-api-key-here
USER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
USER_GEMINI_MODEL=gemini-3.6-flash
